/target
.DS_Store

# Homage Maps and other private content; must never be committed (docs/adr/0003).
/content/private/

# Raw third-party asset packs and downloads; only processed, license-checked files get committed
# (into crates/frontline/assets/ with a CREDITS entry).
/content/incoming/
/content/assets/
__pycache__/
/dist

# MapEdit screenshots (F12).
/screenshots/

# MapEdit's live preview of the Map being edited (deleted when it closes).
.mapedit-*.map

# Z-Town reference imagery (Google Maps screenshots, personal photos): local only, the repo is public.
/docs/z-town/*.png
/docs/z-town/*.svg
/docs/z-town/*.HEIC
