// Local player movement tuning. Read at startup from ./data/ (falls back to the copy built into
// the binary). Metres, seconds, metres per second.
(
    walk_speed: 5.5,
    sprint_speed: 8.5,
    crouch_speed: 3.0,
    prone_speed: 1.2,
    sprint_stamina_secs: 4.0,
    stamina_regen_per_sec: 1.0,
    sprint_restart_stamina: 1.0,
    ground_accel: 60.0,
    air_accel: 8.0,
    gravity: 18.0,
    terminal_fall_speed: 40.0,
    jump_height: 1.15,
    landing_slow_scale: 0.5,
    landing_slow_secs: 0.3,
    mantle_max_height: 1.6,
    mantle_reach: 0.6,
    mantle_secs: 0.4,
    // Vault (over a thin wall or window sill; a jump into it, like a mantle): sill top between
    // the min and max height above the feet, wall at most max_thickness thick, the floor behind
    // at most max_drop below the feet.
    vault_min_height: 0.6,
    vault_max_height: 1.2,
    vault_max_thickness: 0.6,
    vault_max_drop: 1.0,
    vault_secs: 0.5,
    // Dive to prone (prone pressed while sprinting): lunge, then no movement/fire/stand, then a
    // short wait before the prone player may stand or sprint again.
    dive_speed: 4.0,
    dive_secs: 0.35,
    dive_hop_height: 0.12,
    dive_recover_secs: 0.5,
    dive_getup_secs: 0.3,
)
