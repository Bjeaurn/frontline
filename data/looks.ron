// Look presets: the per-Map mood layered on the fixed camera setup (tone curve, bloom, SSAO) in
// crates/frontline/src/atmosphere.rs. A Map picks one by name (data/maps.ron `look`, or the
// map's worldspawn `look`). The target is the gritty CoD4 grade: hard sun, cool shadows, muted
// colour, dust haze and dark screen corners.
//
// - exposure: stops (EV) added to the camera; negative is darker.
// - temperature / tint: white balance shifts (warm + / cool -, magenta + / green -), about -1..1.
// - saturation: 1 is unchanged. contrast: midtone contrast, 1 is unchanged.
// - fog_visibility: metres at which the fog hides about 95% of a surface (lower is denser). Sized
//   to the Maps: about 1.5x the longest dimension of the biggest Map using the look, so the far
//   side is hazy but never hidden (Crossroads 123 m: overcast_urban 185; Backlot 113 m:
//   desert_dust 170). Looks no Map uses are scaled like overcast_urban (x1.09).
// - fog_sun_color: colour of sunlight glowing through the fog towards the sun; alpha is strength.
// - sun_illuminance: lux. sun_direction: the way the light travels (y down is negative).
// - ambient_color / ambient_ground / ambient_brightness: the fill light, as a hemisphere: sky_zenith
//   lights from above, ambient_color from the sides, ambient_ground bounces up from below
//   (cd/m^2 for the brightness).
// - sky_zenith: the colour of the sky straight up; it fades to fog_color at the horizon so the sky
//   meets the fogged distance. sky_clouds: cloud cover, 0 (clear) to 1 (overcast). The sun and its
//   glow sit where the light comes from.
// - vignette: how dark the screen corners get, 0..1.
// - practical_lights: scale of the Map's lamps (light entities with targetname "practical"); 0 when
//   omitted, so only night looks switch them on.
// Colours are sRGB 0..1.
{
    // Grey, overcast city: flat soft light, cool grey sky, desaturated and heavy contrast.
    "overcast_urban": (
        exposure: 0.05,
        temperature: -0.02,
        tint: 0.0,
        saturation: 0.7,
        contrast: 1.2,
        fog_color: (0.50, 0.53, 0.56),
        fog_visibility: 185.0,
        fog_sun_color: (0.85, 0.84, 0.80, 0.18),
        sun_color: (0.94, 0.92, 0.86),
        sun_illuminance: 9500.0,
        sun_direction: (-0.35, -0.85, -0.4),
        ambient_color: (0.72, 0.78, 0.88),
        ambient_ground: (0.42, 0.40, 0.37),
        ambient_brightness: 260.0,
        sky_zenith: (0.40, 0.45, 0.52),
        sky_clouds: 0.95,
        vignette: 0.5,
    ),
    // Sun-bleached desert town: harsh high sun, sepia dust haze, deep blue-ish shadows.
    "desert_dust": (
        exposure: -0.2,
        temperature: 0.03,
        tint: 0.01,
        saturation: 0.72,
        contrast: 1.18,
        fog_color: (0.74, 0.66, 0.54),
        fog_visibility: 230.0,
        fog_sun_color: (1.0, 0.84, 0.60, 0.40),
        sun_color: (1.0, 0.88, 0.68),
        sun_illuminance: 15000.0,
        sun_direction: (0.5, -0.72, -0.5),
        ambient_color: (0.60, 0.68, 0.84),
        ambient_ground: (0.62, 0.48, 0.34),
        ambient_brightness: 700.0,
        sky_zenith: (0.30, 0.56, 0.70),
        sky_clouds: 0.18,
        vignette: 0.5,
    ),
    // Cold winter dawn: low orange sun raking across, blue shadows and haze.
    "dawn_cold": (
        exposure: 0.0,
        temperature: -0.03,
        tint: 0.01,
        saturation: 0.66,
        contrast: 1.16,
        fog_color: (0.52, 0.55, 0.64),
        fog_visibility: 240.0,
        fog_sun_color: (1.0, 0.72, 0.50, 0.45),
        sun_color: (1.0, 0.72, 0.50),
        sun_illuminance: 11000.0,
        sun_direction: (-0.85, -0.28, -0.45),
        ambient_color: (0.52, 0.60, 0.86),
        ambient_ground: (0.42, 0.37, 0.35),
        ambient_brightness: 520.0,
        sky_zenith: (0.26, 0.36, 0.62),
        sky_clouds: 0.45,
        vignette: 0.5,
    ),
    // Humid jungle, daytime: bright filtered sun, lush greens, soft green-white haze.
    "jungle_humid": (
        exposure: -0.1,
        temperature: 0.0,
        tint: -0.05,
        saturation: 0.85,
        contrast: 1.1,
        fog_color: (0.56, 0.67, 0.56),
        fog_visibility: 165.0,
        fog_sun_color: (0.90, 1.0, 0.72, 0.28),
        sun_color: (0.92, 1.0, 0.76),
        sun_illuminance: 11000.0,
        sun_direction: (-0.3, -1.0, -0.25),
        ambient_color: (0.52, 0.72, 0.56),
        ambient_ground: (0.28, 0.34, 0.18),
        ambient_brightness: 250.0,
        sky_zenith: (0.40, 0.60, 0.72),
        sky_clouds: 0.55,
        vignette: 0.5,
    ),
    // Cool blue-green dusk over wet farmland: a low, pale blue-white sun, a dark blue sky fading
    // into a teal mist that swallows the far tree lines, green only in the fill from the fields,
    // heavy vignette. Sized to Overgrown (212 m: the fog is about 1.2x the 165-190 m of the other
    // presets).
    "green_dusk": (
        exposure: -0.22,
        temperature: -0.13,
        tint: -0.04,
        saturation: 0.8,
        contrast: 1.2,
        fog_color: (0.19, 0.30, 0.37),
        fog_visibility: 200.0,
        fog_sun_color: (0.55, 0.72, 0.80, 0.22),
        sun_color: (0.72, 0.85, 0.98),
        sun_illuminance: 5600.0,
        sun_direction: (0.62, -0.34, 0.30),
        ambient_color: (0.32, 0.50, 0.70),
        ambient_ground: (0.13, 0.25, 0.15),
        ambient_brightness: 320.0,
        sky_zenith: (0.06, 0.15, 0.33),
        sky_clouds: 0.7,
        vignette: 0.6,
    ),
    // Moonlit night: a clear blue cast throughout (cold moon, blue fog and sky), lifted enough that
    // players read against the ground at ~30 m, with the Map's warm practical lights on.
    "night_ops": (
        exposure: 0.15,
        temperature: -0.1,
        tint: 0.03,
        saturation: 0.7,
        contrast: 1.12,
        fog_color: (0.07, 0.11, 0.22),
        fog_visibility: 175.0,
        fog_sun_color: (0.40, 0.55, 1.0, 0.25),
        sun_color: (0.62, 0.72, 1.0),
        sun_illuminance: 2800.0,
        sun_direction: (-0.55, -0.7, -0.45),
        ambient_color: (0.42, 0.52, 0.80),
        ambient_ground: (0.14, 0.16, 0.26),
        ambient_brightness: 190.0,
        sky_zenith: (0.02, 0.04, 0.12),
        sky_clouds: 0.3,
        vignette: 0.55,
        practical_lights: 1.0,
    ),
}
