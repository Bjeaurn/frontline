// Grenades: thrown equipment (Frag, Flashbang, Smoke) and the underslung launcher's round
// (Launcher). Read at startup from ./data/ (falls back to the copy built into the binary). The
// server flies each one as a physical projectile; clients draw it. Distances in metres, times in
// seconds, speeds in m/s. Which items a class can carry is data/class_points.ron.
//
//   speed, gravity   launch speed along the aim and the downward pull (game-tuned, not
//                    physical). For a thrown one `speed` is the cap: no throw may be faster
//                    (the client picks the speed by the look angle, the server clamps it)
//   throw            thrown ones only: how a throw leaves the hand by the look angle. A throw
//                    leaves lob_deg above the aim, at level_speed looking at the horizon. Looking
//                    up, the speed goes to up_speed and the lob fades out by up_pitch_deg above
//                    the horizon (farther and higher, 25-30 m at the horizon, about 40 m at 45
//                    degrees up). Looking down the speed falls to down_speed straight down
//                    (a short underhand toss, a few metres at 45 degrees down). A Grenade never
//                    leaves the hand steeper than max_launch_deg.
//   restitution      share of the speed into a surface kept when bouncing off it
//   friction         share of the sideways speed kept on a bounce
//   radius           collision radius of the body
//   fuse             Timed(secs): bursts that long after leaving the hand;
//                    Impact(arm_distance, max_secs): bursts on the first surface it hits once it has
//                    flown arm_distance, or after max_secs in the air
//   effect           Blast(damage, radius): `damage` at the centre, falling off linearly to nothing
//                    at `radius`, only to players it can reach in a straight line;
//                    Flash(radius, blind_secs, deaf_secs): blinds (white-out) players looking at it
//                    and deafens everyone, both fading with distance;
//                    Smoke(radius, secs): a cloud that blocks the view for `secs`
//   count            how many a player carries (the Launcher's: rounds per life)
//   cooldown_secs    wait between two throws of the same kind (Launcher: between rounds)
{
    Frag: (
        name: "Frag Grenade",
        speed: 25.0,
        gravity: 14.0,
        restitution: 0.35,
        friction: 0.6,
        radius: 0.06,
        fuse: Timed(3.0),
        effect: Blast(damage: 150.0, radius: 8.0),
        count: 1,
        cooldown_secs: 1.0,
        throw: Some((
            lob_deg: 16.0,
            max_launch_deg: 70.0,
            down_speed: 3.0,
            level_speed: 25.0,
            up_speed: 23.0,
            up_pitch_deg: 45.0,
        )),
    ),
    Flashbang: (
        name: "Flashbang",
        speed: 25.0,
        gravity: 14.0,
        restitution: 0.35,
        friction: 0.6,
        radius: 0.06,
        fuse: Timed(2.4),
        effect: Flash(radius: 16.0, blind_secs: 5.0, deaf_secs: 6.0),
        count: 2,
        cooldown_secs: 1.0,
        throw: Some((
            lob_deg: 16.0,
            max_launch_deg: 70.0,
            down_speed: 3.0,
            level_speed: 25.0,
            up_speed: 23.0,
            up_pitch_deg: 45.0,
        )),
    ),
    Smoke: (
        name: "Smoke Grenade",
        speed: 25.0,
        gravity: 14.0,
        restitution: 0.3,
        friction: 0.5,
        radius: 0.06,
        fuse: Timed(3.0),
        effect: Smoke(radius: 5.5, secs: 14.0),
        count: 1,
        cooldown_secs: 1.0,
        throw: Some((
            lob_deg: 16.0,
            max_launch_deg: 70.0,
            down_speed: 3.0,
            level_speed: 25.0,
            up_speed: 23.0,
            up_pitch_deg: 45.0,
        )),
    ),
    Launcher: (
        name: "40mm Grenade",
        speed: 58.0,
        gravity: 9.8,
        restitution: 0.2,
        friction: 0.5,
        radius: 0.05,
        fuse: Impact(arm_distance: 5.0, max_secs: 4.0),
        effect: Blast(damage: 130.0, radius: 5.5),
        count: 3,
        cooldown_secs: 2.5,
    ),
}
