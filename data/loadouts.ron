// Loadouts. Read at startup from ./data/ (falls back to the copy built into the binary).
(
    // A Loadout picked within this many seconds of spawning swaps the held Weapon at once;
    // later picks apply on the next spawn.
    swap_window_secs: 5.0,
    // Switching between Primary and Secondary: lowering one and raising the other takes this long.
    weapon_switch_secs: 0.4,
    // The knife every class carries (V by default, as in CoD4): one strike at whoever is in
    // reach ahead of you. 135 damage kills from full health (Perks don't change it; the Match
    // Rules' damage_scale does); `radius` is the swept sphere that finds them, so a strike
    // needs no exact aim; nothing fires, aims or throws during the `swing_secs`.
    knife: (damage: 135.0, range: 1.6, radius: 0.3, swing_secs: 0.6),
    // The Default Loadouts, offered read-only on the Loadout screen. Each is a valid Pick 10
    // class (class_points.ron). Names are at most 16 characters; anything that breaks the class
    // rules (a Weapon, Attachment or Perk that doesn't fit its place, too many points) stops
    // the game at startup. Default Loadouts ignore the unlock tables: they are always usable.
    defaults: [
        (
            // 9 points: Primary 1, Red Dot 1, Foregrip 1, Secondary 1, three Perks 3, Frag 1, Flashbang 1.
            name: "Assault",
            primary: AssaultRifle,
            attachments: (optic: Some(RedDot), underbarrel: Some(Foregrip)),
            secondary: Some(Pistol),
            perks: (picks: (Some(SleightOfHand), Some(StoppingPower), Some(Marathon))),
            lethal: Some(Frag),
            tactical: Some(Flashbang),
        ),
        (
            // 8 points: Primary 1, Silencer 1, Foregrip 1, Secondary 1, three Perks 3, Smoke 1.
            name: "Close Quarters",
            primary: Smg,
            attachments: (muzzle: Some(Silencer), underbarrel: Some(Foregrip)),
            secondary: Some(Pistol),
            perks: (picks: (Some(Scavenger), Some(Lightweight), Some(Ninja))),
            tactical: Some(Smoke),
        ),
        (
            // 6 points: Primary 1, Silencer 1, Secondary 1, three Perks 3.
            name: "Marksman",
            primary: SniperRifle,
            attachments: (muzzle: Some(Silencer)),
            secondary: Some(Pistol),
            perks: (picks: (Some(SleightOfHand), Some(StoppingPower), Some(Ninja))),
        ),
        (
            // 9 points: Primary 1, Grenade Launcher 2, Secondary 1, three Perks 3, Frag 1, Smoke 1.
            // V switches to the launcher (a click fires it), G throws the Frag, Q the Smoke.
            name: "Grenadier",
            primary: M16,
            attachments: (underbarrel: Some(GrenadeLauncher)),
            secondary: Some(Pistol),
            perks: (picks: (Some(Scavenger), Some(StoppingPower), Some(Marathon))),
            lethal: Some(Frag),
            tactical: Some(Smoke),
        ),
    ],
)
