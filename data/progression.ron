// Progression: XP awards, the Level curve, what each Level unlocks, Weapon Levels and the
// weapon camos with their challenges. Read at startup from ./data/ (falls back to the copy
// built into the binary). The server awards XP (a client's Profile stores it, docs/adr/0002),
// so a Host's numbers apply to everyone on it. All amounts are whole XP.
(
    xp: (
        kill: 100,
        // On top of `kill` when the killing shot hit the head.
        headshot: 50,
        // An Assist (damage on an enemy someone else killed, this life) pays `damage * assist_per_damage`.
        assist_per_damage: 1.0,
        // Damage below this earns no Assist.
        assist_min_damage: 10.0,
        // A kill within this many seconds of your previous one continues a Multikill.
        multikill_window_secs: 4.0,
        // Bonus for the 2nd, 3rd, ... kill in a row (double, triple, ...); the last entry
        // repeats for longer chains.
        multikill_bonuses: [50, 100, 150, 200],
        flag_capture: 150,
        // Killing an enemy standing in a Flag zone your team holds.
        flag_defend_kill: 50,
        hq_capture: 150,
        hq_destroy: 150,
        bomb_plant: 200,
        bomb_defuse: 200,
        match_win: 500,
        match_played: 200,
    ),
    // Reaching Level n+1 takes n * xp_per_level XP in all (Level 2 at 1500, Level 3 at 3000, ...);
    // Level `max_level` is the last.
    levels: (
        xp_per_level: 1500,
        max_level: 30,
    ),
    // The account Level each item unlocks at: Weapons, Perks, equipment and Wildcards. An item
    // that isn't listed is available from Level 1. Attachments are not here: each Weapon's own
    // level unlocks them (`weapon_levels` and `weapon_attachments` below). Default Loadouts
    // ignore all of this: they are always usable.
    unlocks: [
        (level: 1, item: Weapon(AssaultRifle)),
        (level: 1, item: Weapon(Smg)),
        (level: 1, item: Weapon(SniperRifle)),
        (level: 1, item: Weapon(Pistol)),
        (level: 4, item: Weapon(M16)),
        (level: 1, item: Perk(SleightOfHand)),
        (level: 1, item: Perk(StoppingPower)),
        (level: 1, item: Perk(Marathon)),
        (level: 2, item: CustomLoadouts),
        (level: 5, item: Perk(Scavenger)),
        (level: 6, item: Perk(Lightweight)),
        (level: 6, item: Wildcard(Gunfighter)),
        (level: 8, item: Perk(Ninja)),
        (level: 8, item: Wildcard(PerkGreed1)),
        (level: 9, item: Wildcard(PerkGreed2)),
        (level: 10, item: Wildcard(PerkGreed3)),
        (level: 12, item: Wildcard(Overkill)),
        // Perks added later, spread over the Levels (Perk Slots 1, 2, 3 noted).
        (level: 3, item: Perk(Bandolier)),       // 1
        (level: 7, item: Perk(Hardened)),        // 3
        (level: 9, item: Perk(QuickRecovery)),   // 2
        (level: 11, item: Perk(SteadyAim)),      // 1
        (level: 13, item: Perk(FallGuard)),      // 3
        (level: 16, item: Perk(TacticalMask)),   // 3
        (level: 18, item: Perk(Juggernaut)),     // 2
        (level: 21, item: Perk(Quickdraw)),      // 1
        (level: 24, item: Perk(DangerClose)),    // 2
        // Weapons added later: the AKS-74U (a second SMG) first, then the AK-47, the shotgun last.
        (level: 6, item: Weapon(Aks74u)),
        (level: 9, item: Weapon(Ak47)),
        (level: 14, item: Weapon(Shotgun)),
        // Equipment: the Frag is there from Level 1.
        (level: 3, item: Equipment(Flashbang)),
        (level: 4, item: Equipment(Smoke)),
        // More equipment (lethal L, tactical T): the Stun Grenade and Semtex early enough to try,
        // Tear Gas in the middle, the Proximity Mine (2 class points) late.
        (level: 8, item: Equipment(Stun)),       // T
        (level: 10, item: Equipment(Semtex)),    // L
        (level: 14, item: Equipment(TearGas)),   // T
        (level: 17, item: Equipment(Mine)),      // L
    ],
    // Weapon Levels: every kill with a Weapon gives that Weapon XP (`xp_per_kill`, plus
    // `xp_per_headshot` when the killing shot hit the head). `thresholds` is the Weapon XP at
    // which Weapon Level 1, 2, 3, ... is reached (strictly rising).
    weapon_levels: (
        xp_per_kill: 1,
        xp_per_headshot: 1,
        thresholds: [5, 15, 30, 50, 75],
    ),
    // Which Attachments each Weapon offers and the Weapon Level that unlocks each, in the order
    // they are listed in the editor. A Weapon not listed (the pistol) offers none, and an
    // Attachment a Weapon doesn't list can't be fitted to it (the sniper has no Optics).
    weapon_attachments: {
        AssaultRifle: [
            (level: 1, attachment: RedDot),
            (level: 2, attachment: Silencer),
            (level: 2, attachment: Reflex),
            (level: 3, attachment: Holographic),
            (level: 3, attachment: Compensator),
            (level: 3, attachment: AngledGrip),
            (level: 4, attachment: Foregrip),
            (level: 4, attachment: Prism),
            (level: 4, attachment: FlashHider),
            (level: 5, attachment: Acog),
            (level: 5, attachment: Scope6x),
        ],
        Smg: [
            (level: 1, attachment: RedDot),
            (level: 2, attachment: Silencer),
            (level: 2, attachment: Reflex),
            (level: 3, attachment: Holographic),
            (level: 3, attachment: FlashHider),
            (level: 4, attachment: Foregrip),
            (level: 4, attachment: AngledGrip),
            (level: 4, attachment: Compensator),
            (level: 5, attachment: Prism),
        ],
        // The M16A4 is the only Weapon with the grenade launcher (it shares the Underbarrel slot with
        // the Foregrip).
        M16: [
            (level: 1, attachment: RedDot),
            (level: 2, attachment: Silencer),
            (level: 2, attachment: GrenadeLauncher),
            (level: 2, attachment: Reflex),
            (level: 3, attachment: Holographic),
            (level: 3, attachment: Compensator),
            (level: 4, attachment: Foregrip),
            (level: 4, attachment: FlashHider),
            (level: 5, attachment: Acog),
            (level: 5, attachment: Scope6x),
        ],
        // The AK-47: its kick is the reason to bring a Compensator or a grip.
        Ak47: [
            (level: 1, attachment: RedDot),
            (level: 2, attachment: Silencer),
            (level: 2, attachment: Compensator),
            (level: 3, attachment: Holographic),
            (level: 3, attachment: Foregrip),
            (level: 4, attachment: AngledGrip),
            (level: 4, attachment: Acog),
            (level: 5, attachment: FlashHider),
            (level: 5, attachment: Scope6x),
        ],
        Aks74u: [
            (level: 1, attachment: RedDot),
            (level: 2, attachment: Reflex),
            (level: 2, attachment: Silencer),
            (level: 3, attachment: Foregrip),
            (level: 3, attachment: FlashHider),
            (level: 4, attachment: Holographic),
            (level: 4, attachment: AngledGrip),
            (level: 5, attachment: Compensator),
        ],
        // The shotgun takes no Underbarrel Attachment (its forend is the pump).
        Shotgun: [
            (level: 1, attachment: RedDot),
            (level: 2, attachment: Reflex),
            (level: 3, attachment: Compensator),
            (level: 4, attachment: Silencer),
            (level: 4, attachment: FlashHider),
            (level: 5, attachment: Holographic),
        ],
        SniperRifle: [
            (level: 1, attachment: Silencer),
            (level: 2, attachment: FlashHider),
            (level: 3, attachment: Foregrip),
            (level: 4, attachment: Compensator),
            (level: 5, attachment: AngledGrip),
        ],
    },
    // Weapon camos. A camo is unlocked per Weapon by its `challenge`, counted on that Weapon:
    //   Kills(n) / Headshots(n)   n kills / headshot kills with it
    //   AllOthers                 every other camo unlocked on it
    // `texture` is under assets/camos/ (made by tools/camos/camos.py); `swatch` is the colour the
    // editor shows; `metallic` and `roughness` shape the material.
    camos: [
        (id: "woodland", name: "Woodland", texture: "woodland.png", swatch: (0.33, 0.38, 0.20), challenge: Kills(25)),
        (id: "desert", name: "Desert", texture: "desert.png", swatch: (0.77, 0.66, 0.46), challenge: Kills(50)),
        (id: "urban", name: "Urban", texture: "urban.png", swatch: (0.50, 0.51, 0.52), challenge: Headshots(25)),
        (id: "tiger", name: "Tiger", texture: "tiger.png", swatch: (0.69, 0.45, 0.19), challenge: Kills(100)),
        (id: "arctic", name: "Arctic", texture: "arctic.png", swatch: (0.89, 0.91, 0.93), challenge: Headshots(50)),
        (id: "gold", name: "Gold", texture: "gold.png", swatch: (0.84, 0.66, 0.20), metallic: 0.6, roughness: 0.35, challenge: AllOthers),
    ],
)
