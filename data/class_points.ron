// Class points ("Pick 10"): every class has a point budget and each choice costs points. Read at
// startup from ./data/ (falls back to the copy built into the binary).
(
    budget: 10,
    costs: (
        primary: 1,
        secondary: 1,
        // Each Attachment, unless its own `cost` (attachments.ron) says otherwise.
        attachment: 1,
        // An Optic of at least `heavy_optic_magnification` costs `heavy_optic` instead.
        heavy_optic_magnification: 3.0,
        heavy_optic: 2,
        perk: 1,
        // Each piece of equipment, unless its own `cost` (below) says otherwise.
        equipment: 1,
        wildcard: 1,
    ),
    // Attachments on the Primary: this many, and `gunfighter_extra_attachments` more with Gunfighter.
    max_attachments: 2,
    gunfighter_extra_attachments: 1,
    max_wildcards: 3,
    // What each Wildcard is called and does. The unlock Level is in progression.ron.
    //   PerkGreedN   a second Perk in Perk Slot N (its effects stack with the first)
    //   Gunfighter   a third Attachment on the Primary
    //   Overkill     a Primary Weapon in the Secondary slot
    wildcards: {
        PerkGreed1: (name: "Perk 1 Greed", description: "A second Perk in Perk Slot 1."),
        PerkGreed2: (name: "Perk 2 Greed", description: "A second Perk in Perk Slot 2."),
        PerkGreed3: (name: "Perk 3 Greed", description: "A second Perk in Perk Slot 3."),
        Gunfighter: (name: "Gunfighter", description: "A third Attachment on your Primary."),
        Overkill: (name: "Overkill", description: "A Primary Weapon as your second Weapon."),
    },
    // Equipment: lethal and tactical items with their own `name`, `description`, `slot` (Lethal or
    // Tactical) and optional `cost`. How each Grenade flies and what it does is data/equipment.ron.
    equipment: {
        Frag: (
            name: "Frag Grenade",
            description: "Lethal. Bounces, then bursts after 3 s: heavy damage that fades with distance. Throw with G.",
            slot: Lethal,
        ),
        Semtex: (
            name: "Semtex",
            description: "Lethal. Sticks to the first wall, floor or player it touches and bursts 1.5 s later: a smaller blast than a Frag, but it doesn't roll away. Throw with G.",
            slot: Lethal,
        ),
        Mine: (
            name: "Proximity Mine",
            description: "Lethal. Thrown onto a surface, it arms after 1.5 s and bursts, with a heavy blast, when an enemy comes within 2.6 m in the open. You keep two down; a third removes your oldest. Throw with G.",
            slot: Lethal,
            cost: Some(2),
        ),
        Flashbang: (
            name: "Flashbang",
            description: "Tactical. Bursts after 2.4 s: anyone near it looking its way is blinded, and everyone near is deafened. Throw with Q.",
            slot: Tactical,
        ),
        Stun: (
            name: "Stun Grenade",
            description: "Tactical. Bursts after 2 s: everyone within 12 m, even behind cover, is slowed and has the view shaken for up to 6 s, fading with distance. No damage. Throw with Q.",
            slot: Tactical,
        ),
        Smoke: (
            name: "Smoke Grenade",
            description: "Tactical. Bursts into a cloud that blocks the view for about 25 s. Throw with Q.",
            slot: Tactical,
        ),
        TearGas: (
            name: "Tear Gas",
            description: "Tactical. Bursts after 2 s into a cloud for about 16 s: whoever stands in it coughs, is slowed and sees only a narrow tunnel, for a moment after leaving too. No damage. Throw with Q.",
            slot: Tactical,
        ),
    },
)
