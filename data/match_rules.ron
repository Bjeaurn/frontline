// Match Rules presets (see CONTEXT.md). Read at startup from ./data/ (falls back to the copy
// built into the binary). Health in HP, times in seconds. A server runs `default` unless
// started with `--rules <preset>`; the server sends the values to clients in the Match state.
// Hosts add their own sets in the rules editor (`<config dir>/frontline/rules.ron`); these two
// presets are the read-only starting points.
// `respawn_delay_secs` is how long a dead player waits before respawning by themselves;
// `min_respawn_secs` is how soon they may ask to respawn early (SPACE or click).
// `killcam_secs` is how long the Kill-cam (the killer's view up to the kill) plays for a player
// killed by someone else, 0 for none; their respawn waits for it (plus 1.5 s of death screen).
// Hardcore has none; a custom set copied from it can switch it on in the rules editor.
// `hud.name_tag_range_m`: friendly name tags are fully visible up to 70% of this distance in
// metres and fade out to nothing at it; sets saved without it get 45.
// `fall_damage`: no damage up to `min_height` metres of fall (from the peak), then linear up to
// a lethal fall of `max_height`.
{
    "default": (
        max_health: 100.0,
        regen_delay_secs: 5.0,
        regen_per_sec: 40.0,
        respawn_delay_secs: 3.0,
        min_respawn_secs: 1.5,
        killcam_secs: 5.0,
        damage_scale: 1.0,
        friendly_fire: false,
        fall_damage: (min_height: 4.5, max_height: 12.0),
        hud: (
            crosshair: true,
            hitmarkers: true,
            kill_hitmarker: true,
            kill_feed: true,
            kill_feed_delay_secs: 0.0,
            damage_direction: true,
            name_tags: true,
            name_tag_range_m: 45.0,
        ),
    ),
    "hardcore": (
        max_health: 30.0,
        regen_delay_secs: 5.0,
        regen_per_sec: 0.0,
        respawn_delay_secs: 3.0,
        min_respawn_secs: 1.5,
        killcam_secs: 0.0,
        damage_scale: 1.0,
        friendly_fire: true,
        fall_damage: (min_height: 3.5, max_height: 8.0),
        hud: (
            crosshair: false,
            hitmarkers: false,
            kill_hitmarker: false,
            kill_feed: true,
            kill_feed_delay_secs: 6.0,
            damage_direction: false,
            name_tags: true,
            name_tag_range_m: 45.0,
        ),
    ),
}
