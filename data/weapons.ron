// Weapon tuning. Read at startup from ./data/ (falls back to the copy built into the binary).
// Distances in metres, angles in degrees, times in seconds. `damage_near`/`damage_far` are
// scaled by the Hit Zone struck: head, upper torso (chest), lower torso (belly) or limbs.
// `reload_secs` is the reload with rounds left, `empty_reload_secs` from an empty magazine.
// Aim mechanics: `iron_magnification` / `iron_sway_scale` describe the Weapon's own sight (its
// iron sights, or the Sniper's built-in scope); an Optic brings its own (attachments.ron). The ADS
// field of view follows the magnification, and from 3x you can hold breath and show a glint.
// `sway_deg` is the idle sway's peak angle at a sway scale of 1 (standing, breathing),
// `flinch_deg` the view kick of a 50-damage hit from the hip (less when aimed).
// Fire modes: `fire_modes` lists the modes X cycles through, the first is the default. `Auto` fires
// while the trigger is held at `rpm`; `Burst(n)` fires n rounds per pull at `burst_rpm` and, with the
// trigger held, another burst after `burst_delay_secs` (on top of the last round's spacing, so the gap
// between bursts is clearly longer than the one inside a burst); `Semi` is one round per pull at `rpm`
// but never faster than `semi_interval_secs` (mashing the button can't beat it); `Bolt`
// (a bolt-action, listed alone) fires one round and then needs a rack: `rack_secs_scoped` is the
// click-to-rack time while aimed (with a `rack_kick_deg` sway kick), `rack_secs_unscoped` the
// automatic rack once the sights are released.
// Ammo: besides the magazine in the gun a Weapon carries `reserve_mags` spare magazines (the Reserve,
// `reserve_mags * magazine` rounds, shown as `30 / 120`); a reload moves rounds from it into the
// magazine and with the Reserve empty does nothing. Dead players' ammo packs, Domination Flags and
// Team Deathmatch crates refill it (perks.ron, game_modes.ron); a respawn restores it in full.
// A Weapon's own gunshot is `shot_sound` at `shot_volume` and `shot_pitch` (1 when left out): guns that
// share a recording sound different through them; a Muzzle Attachment scales both further.
// `pellets` (1 when left out) is how many bullets one round fires: each its own ray with its own spread,
// each dealing the damage below (a shotgun).
{
    AssaultRifle: (
        name: "M4 (AR)",
        fire_modes: [Auto, Burst(3), Semi],
        burst_rpm: 660.0,        // 0.09 s between burst rounds: slower than the 750 rpm auto rate
        burst_delay_secs: 0.28,
        semi_interval_secs: 0.14,
        rpm: 750.0,
        ads_rpm: 715.0,
        damage_near: 30.0,
        damage_far: 20.0,
        falloff_start: 20.0,
        falloff_end: 40.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 300.0,
        magazine: 30,
        reserve_mags: 4,
        reload_secs: 2.5,
        empty_reload_secs: 3.1,
        hip_spread_deg: 3.0,
        ads_spread_deg: 0.25,
        ads_secs: 0.25,
        ads_move_scale: 0.6,
        recoil_pitch_deg: 0.9,
        recoil_yaw_deg: 0.35,
        recoil_recovery_per_sec: 6.0,
        ads_recoil_scale: 0.55,
        move_spread_deg: 2.0,
        air_spread_deg: 5.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.2,
        move_scale: 1.0,
        model: Carbine,
        shot_sound: "embedded://frontline/sounds/shot_ar.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats. `sight_point` and
        // `sight_eye_relief` are where an Optic sits; `iron_*` are the iron sights.
        muzzle_offset: (0.0, 0.033, -0.500),
        sight_point: (0.0, 0.088, -0.07),
        sight_eye_relief: 0.16,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.078, 0.045),
        iron_eye_relief: 0.3,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.5,
        flinch_deg: 2.0,
    ),
    // The M16A4: a 3-round burst rifle with no full auto, heavier hitting and steadier than the M4.
    // The only Weapon that offers the grenade launcher (progression.ron: weapon_attachments).
    M16: (
        name: "M16A4 (AR)",
        fire_modes: [Burst(3), Semi],
        burst_rpm: 660.0,
        burst_delay_secs: 0.24,
        semi_interval_secs: 0.14,
        rpm: 700.0,
        ads_rpm: 670.0,
        damage_near: 34.0,
        damage_far: 24.0,
        falloff_start: 25.0,
        falloff_end: 50.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 320.0,
        magazine: 30,
        reserve_mags: 4,
        reload_secs: 2.6,
        empty_reload_secs: 3.2,
        hip_spread_deg: 2.8,
        ads_spread_deg: 0.2,
        ads_secs: 0.27,
        ads_move_scale: 0.6,
        recoil_pitch_deg: 0.8,
        recoil_yaw_deg: 0.3,
        recoil_recovery_per_sec: 6.0,
        ads_recoil_scale: 0.55,
        move_spread_deg: 2.0,
        air_spread_deg: 5.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.2,
        move_scale: 0.98,
        model: Rifle,
        shot_sound: "embedded://frontline/sounds/shot_ar.ogg",
        muzzle_offset: (0.0, 0.033, -0.580),
        sight_point: (0.0, 0.088, -0.07),
        sight_eye_relief: 0.16,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.092, 0.089),
        iron_eye_relief: 0.3,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.45,
        flinch_deg: 2.0,
    ),
    // The AK-47: automatic or semi, no burst. Hits harder than the M4 (three chest hits kill up close)
    // and kicks harder, fires slower and takes longer to reload. Its shot is the sniper's 7.62 recording,
    // a touch higher and quieter.
    Ak47: (
        name: "AK-47 (AR)",
        fire_modes: [Auto, Semi],
        semi_interval_secs: 0.15,
        rpm: 600.0,
        ads_rpm: 580.0,
        damage_near: 36.0,
        damage_far: 24.0,
        falloff_start: 20.0,
        falloff_end: 42.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 320.0,
        magazine: 30,
        reserve_mags: 4,
        reload_secs: 2.8,
        empty_reload_secs: 3.4,
        hip_spread_deg: 3.4,
        ads_spread_deg: 0.35,
        ads_secs: 0.28,
        ads_move_scale: 0.6,
        recoil_pitch_deg: 1.3,
        recoil_yaw_deg: 0.6,
        recoil_recovery_per_sec: 5.5,
        ads_recoil_scale: 0.55,
        move_spread_deg: 2.2,
        air_spread_deg: 5.5,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.22,
        move_scale: 0.96,
        model: Ak,
        shot_sound: "embedded://frontline/sounds/shot_sniper.ogg",
        shot_pitch: 1.2,
        shot_volume: 0.85,
        muzzle_offset: (0.0, 0.0275, -0.485),
        sight_point: (0.0, 0.097, -0.17),
        sight_eye_relief: 0.16,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.073, -0.30),
        iron_eye_relief: 0.28,
        iron_magnification: 1.0,
        iron_sway_scale: 0.85,
        sway_deg: 0.55,
        flinch_deg: 2.2,
    ),
    Smg: (
        name: "MP5 (SMG)",
        fire_modes: [Auto, Burst(2), Semi],
        burst_rpm: 705.0,        // 0.085 s between burst rounds (auto is 0.075 s)
        burst_delay_secs: 0.22,
        semi_interval_secs: 0.12,
        rpm: 800.0,
        ads_rpm: 800.0,
        damage_near: 25.0,
        damage_far: 15.0,
        falloff_start: 10.0,
        falloff_end: 25.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 200.0,
        magazine: 30,
        reserve_mags: 4,
        reload_secs: 2.4,
        empty_reload_secs: 2.9,
        hip_spread_deg: 2.5,
        ads_spread_deg: 0.6,
        ads_secs: 0.18,
        ads_move_scale: 0.75,
        recoil_pitch_deg: 0.7,
        recoil_yaw_deg: 0.45,
        recoil_recovery_per_sec: 7.0,
        ads_recoil_scale: 0.6,
        move_spread_deg: 1.5,
        air_spread_deg: 4.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.15,
        move_scale: 1.05,
        model: Smg,
        shot_sound: "embedded://frontline/sounds/shot_smg.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, -0.003, -0.17),
        sight_point: (0.0, 0.06, -0.02),
        sight_eye_relief: 0.12,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.04, 0.0),
        iron_eye_relief: 0.22,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.15,
        flinch_deg: 2.4,
    ),
    // The AKS-74U: a stockless compact AK. A second SMG: hits harder than the MP5 but loses its damage
    // sooner, kicks more and fires a little slower. Its shot is the rifle recording, a touch higher.
    Aks74u: (
        name: "AKS-74U (SMG)",
        fire_modes: [Auto, Semi],
        semi_interval_secs: 0.11,
        rpm: 760.0,
        ads_rpm: 760.0,
        damage_near: 29.0,
        damage_far: 13.0,
        falloff_start: 8.0,
        falloff_end: 20.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 170.0,
        magazine: 30,
        reserve_mags: 4,
        reload_secs: 2.3,
        empty_reload_secs: 2.8,
        hip_spread_deg: 2.7,
        ads_spread_deg: 0.7,
        ads_secs: 0.19,
        ads_move_scale: 0.75,
        recoil_pitch_deg: 0.9,
        recoil_yaw_deg: 0.6,
        recoil_recovery_per_sec: 6.5,
        ads_recoil_scale: 0.6,
        move_spread_deg: 1.6,
        air_spread_deg: 4.2,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.15,
        move_scale: 1.04,
        model: Compact,
        shot_sound: "embedded://frontline/sounds/shot_ar.ogg",
        shot_pitch: 1.12,
        shot_volume: 0.95,
        muzzle_offset: (0.0, 0.0275, -0.382),
        sight_point: (0.0, 0.097, -0.13),
        sight_eye_relief: 0.16,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.073, -0.24),
        iron_eye_relief: 0.24,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.18,
        flinch_deg: 2.4,
    ),
    // A semi-automatic shotgun: one pull fires `pellets` pellets, each its own ray with its own spread
    // (`hip_spread_deg` / `ads_spread_deg` are the cone's radius) and each dealing `damage_near`, falling
    // off to `damage_far`. One pull is one round of the magazine, one kick and one shot sound. A shell
    // that hits at point blank with all its pellets deals 9 x 13 = 117: a kill, but the pattern opens
    // quickly with distance and the damage drops away. The reload racks the forend.
    Shotgun: (
        name: "M870 (Shotgun)",
        fire_modes: [Semi],
        semi_interval_secs: 0.8,
        rpm: 75.0,
        ads_rpm: 75.0,
        pellets: 9,
        damage_near: 13.0,
        damage_far: 2.0,
        falloff_start: 5.0,
        falloff_end: 18.0,
        zone_multipliers: (head: 1.3, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 90.0,
        magazine: 6,
        reserve_mags: 4,         // 24 shells in reserve for the 6-shell magazine
        reload_secs: 3.4,
        empty_reload_secs: 4.0,
        hip_spread_deg: 5.0,
        ads_spread_deg: 2.6,
        ads_secs: 0.3,
        ads_move_scale: 0.55,
        recoil_pitch_deg: 4.5,
        recoil_yaw_deg: 0.8,
        recoil_recovery_per_sec: 4.5,
        ads_recoil_scale: 0.7,
        move_spread_deg: 2.5,
        air_spread_deg: 5.0,
        bloom_follow_per_sec: 6.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.2,
        move_scale: 0.95,
        model: Shotgun,
        // The sniper's boom, slowed down and a touch louder.
        shot_sound: "embedded://frontline/sounds/shot_sniper.ogg",
        shot_pitch: 0.75,
        shot_volume: 1.15,
        muzzle_offset: (0.0, 0.0525, -0.317),
        sight_point: (0.0, 0.095, -0.02),
        sight_eye_relief: 0.16,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.068, 0.07),
        iron_eye_relief: 0.26,
        iron_magnification: 1.0,
        iron_sway_scale: 0.9,
        sway_deg: 0.4,
        flinch_deg: 2.0,
    ),
    // Bolt-action: `Bolt`; the rack (below) paces the shots, `rpm` is only its nominal rate.
    SniperRifle: (
        name: "M40 (Sniper)",
        fire_modes: [Bolt],
        rpm: 50.0,
        ads_rpm: 50.0,
        damage_near: 100.0,
        damage_far: 80.0,
        falloff_start: 80.0,
        falloff_end: 150.0,
        zone_multipliers: (head: 1.5, upper_torso: 1.2, lower_torso: 1.0, limbs: 0.75),
        range: 400.0,
        magazine: 5,
        reserve_mags: 4,         // 20 rounds in reserve for the 5-round magazine
        reload_secs: 3.5,
        empty_reload_secs: 4.0,
        hip_spread_deg: 8.0,
        ads_spread_deg: 0.0,
        ads_secs: 0.35,
        ads_move_scale: 0.4,
        recoil_pitch_deg: 3.0,
        recoil_yaw_deg: 0.5,
        recoil_recovery_per_sec: 4.0,
        ads_recoil_scale: 0.8,
        move_spread_deg: 4.0,
        air_spread_deg: 8.0,
        bloom_follow_per_sec: 6.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.3,
        move_scale: 0.9,
        model: Sniper,
        shot_sound: "embedded://frontline/sounds/shot_sniper.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.043, -0.784),
        sight_point: (0.0, 0.1145, 0.106),
        sight_eye_relief: 0.08,
        scope: true,
        class: Primary,
        iron_point: (0.0, 0.1145, 0.106),
        iron_eye_relief: 0.08,
        iron_magnification: 8.0,
        iron_sway_scale: 1.3,
        sway_deg: 1.0,
        flinch_deg: 2.5,
        rack_secs_scoped: 1.4,
        rack_secs_unscoped: 0.9,
        rack_kick_deg: 0.35,
        // Server-simulated bullet (docs/adr/0005): travel time and drop; other Weapons stay hitscan.
        projectile: Some((muzzle_speed: 600.0, gravity: 12.0)),
    ),
    // Secondary. Semi only: one round per pull at its `rpm`.
    Pistol: (
        name: "M9 (Pistol)",
        fire_modes: [Semi],
        semi_interval_secs: 0.2,
        rpm: 420.0,
        ads_rpm: 420.0,
        damage_near: 28.0,
        damage_far: 17.0,
        falloff_start: 12.0,
        falloff_end: 30.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 150.0,
        magazine: 15,
        reserve_mags: 3,
        reload_secs: 1.7,
        empty_reload_secs: 2.1,
        hip_spread_deg: 1.6,
        ads_spread_deg: 0.5,
        ads_secs: 0.12,
        ads_move_scale: 0.9,
        recoil_pitch_deg: 1.2,
        recoil_yaw_deg: 0.3,
        recoil_recovery_per_sec: 9.0,
        ads_recoil_scale: 0.7,
        move_spread_deg: 1.0,
        air_spread_deg: 3.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.1,
        move_scale: 1.1,
        model: Pistol,
        shot_sound: "embedded://frontline/sounds/shot_smg.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.05, -0.079),
        sight_point: (0.0, 0.067, 0.098),
        sight_eye_relief: 0.16,
        scope: false,
        class: Secondary,
        iron_point: (0.0, 0.067, 0.098),
        iron_eye_relief: 0.16,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.1,
        flinch_deg: 1.6,
    ),
}
