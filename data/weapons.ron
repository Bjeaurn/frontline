// Weapon tuning. Read at startup from ./data/ (falls back to the copy built into the binary).
// Distances in metres, angles in degrees, times in seconds. `damage_near`/`damage_far` are
// scaled by the Hit Zone struck: head, upper torso (chest), lower torso (belly) or limbs.
// `reload_secs` is the reload with rounds left, `empty_reload_secs` from an empty magazine.
// Aim mechanics: `iron_magnification` / `iron_sway_scale` describe the Weapon's own sight (its
// iron sights, or the Sniper's built-in scope); an Optic brings its own (attachments.ron). The ADS
// field of view follows the magnification, and from 3x you can hold breath and show a glint.
// `sway_deg` is the idle sway's peak angle at a sway scale of 1 (standing, breathing),
// `flinch_deg` the view kick of a 50-damage hit from the hip (less when aimed).
// Bolt-action (`bolt_action: true`): a shot opens the bolt; `rack_secs_scoped` is the click-to-rack
// time while aimed (with a `rack_kick_deg` sway kick), `rack_secs_unscoped` the automatic rack
// once the sights are released.
{
    AssaultRifle: (
        name: "M4 (AR)",
        fire_mode: Auto,
        rpm: 750.0,
        ads_rpm: 715.0,
        damage_near: 30.0,
        damage_far: 20.0,
        falloff_start: 20.0,
        falloff_end: 40.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 300.0,
        magazine: 30,
        reload_secs: 2.5,
        empty_reload_secs: 3.1,
        hip_spread_deg: 3.0,
        ads_spread_deg: 0.25,
        ads_secs: 0.25,
        ads_move_scale: 0.6,
        recoil_pitch_deg: 0.9,
        recoil_yaw_deg: 0.35,
        recoil_recovery_per_sec: 6.0,
        ads_recoil_scale: 0.55,
        move_spread_deg: 2.0,
        air_spread_deg: 5.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.2,
        move_scale: 1.0,
        model: Rifle,
        shot_sound: "embedded://frontline/sounds/shot_ar.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats. `sight_point` and
        // `sight_eye_relief` are where an Optic sits; `iron_*` are the iron sights.
        muzzle_offset: (0.0, 0.015, -0.48),
        sight_point: (0.0, 0.095, -0.02),
        sight_eye_relief: 0.16,
        bolt_action: false,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.066, 0.06),
        iron_eye_relief: 0.14,
        iron_front_z: -0.4,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.5,
        flinch_deg: 2.0,
    ),
    Smg: (
        name: "MP5 (SMG)",
        fire_mode: Auto,
        rpm: 800.0,
        ads_rpm: 800.0,
        damage_near: 25.0,
        damage_far: 15.0,
        falloff_start: 10.0,
        falloff_end: 25.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 200.0,
        magazine: 30,
        reload_secs: 2.4,
        empty_reload_secs: 2.9,
        hip_spread_deg: 2.5,
        ads_spread_deg: 0.6,
        ads_secs: 0.18,
        ads_move_scale: 0.75,
        recoil_pitch_deg: 0.7,
        recoil_yaw_deg: 0.45,
        recoil_recovery_per_sec: 7.0,
        ads_recoil_scale: 0.6,
        move_spread_deg: 1.5,
        air_spread_deg: 4.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.15,
        move_scale: 1.05,
        model: Smg,
        shot_sound: "embedded://frontline/sounds/shot_smg.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.01, -0.30),
        sight_point: (0.0, 0.065, 0.09),
        sight_eye_relief: 0.09,
        bolt_action: false,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.065, 0.09),
        iron_eye_relief: 0.09,
        iron_front_z: -0.2,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.15,
        flinch_deg: 2.4,
    ),
    // Bolt-action: `Semi`; the rack (below) paces the shots, `rpm` is only its nominal rate.
    SniperRifle: (
        name: "M40 (Sniper)",
        fire_mode: Semi,
        rpm: 50.0,
        ads_rpm: 50.0,
        damage_near: 100.0,
        damage_far: 80.0,
        falloff_start: 80.0,
        falloff_end: 150.0,
        zone_multipliers: (head: 1.5, upper_torso: 1.2, lower_torso: 1.0, limbs: 0.75),
        range: 400.0,
        magazine: 5,
        reload_secs: 3.5,
        empty_reload_secs: 4.0,
        hip_spread_deg: 8.0,
        ads_spread_deg: 0.0,
        ads_secs: 0.35,
        ads_move_scale: 0.4,
        recoil_pitch_deg: 3.0,
        recoil_yaw_deg: 0.5,
        recoil_recovery_per_sec: 4.0,
        ads_recoil_scale: 0.8,
        move_spread_deg: 4.0,
        air_spread_deg: 8.0,
        bloom_follow_per_sec: 6.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.3,
        move_scale: 0.9,
        model: Sniper,
        shot_sound: "embedded://frontline/sounds/shot_sniper.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.01, -0.86),
        sight_point: (0.0, 0.085, 0.18),
        sight_eye_relief: 0.08,
        bolt_action: true,
        scope: true,
        class: Primary,
        iron_point: (0.0, 0.085, 0.18),
        iron_eye_relief: 0.08,
        iron_front_z: -0.5,
        iron_magnification: 8.0,
        iron_sway_scale: 1.3,
        sway_deg: 1.0,
        flinch_deg: 2.5,
        rack_secs_scoped: 1.4,
        rack_secs_unscoped: 0.9,
        rack_kick_deg: 0.35,
        // Server-simulated bullet (docs/adr/0005): travel time and drop; other Weapons stay hitscan.
        projectile: Some((muzzle_speed: 600.0, gravity: 12.0)),
    ),
    // Secondary. Semi-auto: one round per pull at its `rpm`.
    Pistol: (
        name: "M9 (Pistol)",
        fire_mode: Semi,
        rpm: 420.0,
        ads_rpm: 420.0,
        damage_near: 28.0,
        damage_far: 17.0,
        falloff_start: 12.0,
        falloff_end: 30.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 150.0,
        magazine: 15,
        reload_secs: 1.7,
        empty_reload_secs: 2.1,
        hip_spread_deg: 1.6,
        ads_spread_deg: 0.5,
        ads_secs: 0.12,
        ads_move_scale: 0.9,
        recoil_pitch_deg: 1.2,
        recoil_yaw_deg: 0.3,
        recoil_recovery_per_sec: 9.0,
        ads_recoil_scale: 0.7,
        move_spread_deg: 1.0,
        air_spread_deg: 3.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.1,
        move_scale: 1.1,
        model: Pistol,
        shot_sound: "embedded://frontline/sounds/shot_smg.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.005, -0.145),
        sight_point: (0.0, 0.034, 0.065),
        sight_eye_relief: 0.12,
        bolt_action: false,
        scope: false,
        class: Secondary,
        iron_point: (0.0, 0.034, 0.065),
        iron_eye_relief: 0.12,
        iron_front_z: -0.105,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.1,
        flinch_deg: 1.6,
    ),
}
