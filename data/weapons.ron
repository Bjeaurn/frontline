// Weapon tuning. Read at startup from ./data/ (falls back to the copy built into the binary).
// Distances in metres, angles in degrees, times in seconds. `damage_near`/`damage_far` are
// scaled by the Hit Zone struck: head, upper torso (chest), lower torso (belly) or limbs.
{
    AssaultRifle: (
        name: "M4 (AR)",
        fire_mode: Auto,
        rpm: 750.0,
        ads_rpm: 715.0,
        damage_near: 30.0,
        damage_far: 20.0,
        falloff_start: 20.0,
        falloff_end: 40.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 300.0,
        magazine: 30,
        reload_secs: 2.2,
        hip_spread_deg: 3.0,
        ads_spread_deg: 0.25,
        ads_secs: 0.25,
        ads_fov_scale: 0.7,
        ads_move_scale: 0.6,
        recoil_pitch_deg: 0.9,
        recoil_yaw_deg: 0.35,
        recoil_recovery_per_sec: 6.0,
        ads_recoil_scale: 0.55,
        move_spread_deg: 2.0,
        air_spread_deg: 5.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.2,
        move_scale: 1.0,
        model: Rifle,
        shot_sound: "embedded://frontline/sounds/shot_ar.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.015, -0.48),
        sight_point: (0.0, 0.095, -0.02),
        sight_eye_relief: 0.16,
        bolt_action: false,
        scope: false,
    ),
    Smg: (
        name: "MP5 (SMG)",
        fire_mode: Auto,
        rpm: 800.0,
        ads_rpm: 800.0,
        damage_near: 25.0,
        damage_far: 15.0,
        falloff_start: 10.0,
        falloff_end: 25.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 200.0,
        magazine: 30,
        reload_secs: 2.0,
        hip_spread_deg: 2.5,
        ads_spread_deg: 0.6,
        ads_secs: 0.18,
        ads_fov_scale: 0.8,
        ads_move_scale: 0.75,
        recoil_pitch_deg: 0.7,
        recoil_yaw_deg: 0.45,
        recoil_recovery_per_sec: 7.0,
        ads_recoil_scale: 0.6,
        move_spread_deg: 1.5,
        air_spread_deg: 4.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.15,
        move_scale: 1.05,
        model: Smg,
        shot_sound: "embedded://frontline/sounds/shot_smg.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.01, -0.30),
        sight_point: (0.0, 0.065, 0.09),
        sight_eye_relief: 0.09,
        bolt_action: false,
        scope: false,
    ),
    // Bolt-action: `Semi` with a low rpm, so the rpm is the bolt cycle.
    SniperRifle: (
        name: "M40 (Sniper)",
        fire_mode: Semi,
        rpm: 50.0,
        ads_rpm: 50.0,
        damage_near: 100.0,
        damage_far: 80.0,
        falloff_start: 80.0,
        falloff_end: 150.0,
        zone_multipliers: (head: 1.5, upper_torso: 1.2, lower_torso: 1.0, limbs: 0.75),
        range: 400.0,
        magazine: 5,
        reload_secs: 3.0,
        hip_spread_deg: 8.0,
        ads_spread_deg: 0.0,
        ads_secs: 0.35,
        ads_fov_scale: 0.3,
        ads_move_scale: 0.4,
        recoil_pitch_deg: 3.0,
        recoil_yaw_deg: 0.5,
        recoil_recovery_per_sec: 4.0,
        ads_recoil_scale: 0.8,
        move_spread_deg: 4.0,
        air_spread_deg: 8.0,
        bloom_follow_per_sec: 6.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.3,
        move_scale: 0.9,
        model: Sniper,
        shot_sound: "embedded://frontline/sounds/shot_sniper.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.01, -0.86),
        sight_point: (0.0, 0.085, 0.18),
        sight_eye_relief: 0.08,
        bolt_action: true,
        scope: true,
    ),
}
