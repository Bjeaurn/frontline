// Weapon tuning. Read at startup from ./data/ (falls back to the copy built into the binary).
// Distances in metres, angles in degrees, times in seconds. `damage_near`/`damage_far` are
// scaled by the Hit Zone struck: head, upper torso (chest), lower torso (belly) or limbs.
// `reload_secs` is the reload with rounds left, `empty_reload_secs` from an empty magazine.
// Aim mechanics: `iron_magnification` / `iron_sway_scale` describe the Weapon's own sight (its
// iron sights, or the Sniper's built-in scope); an Optic brings its own (attachments.ron). The ADS
// field of view follows the magnification, and from 3x you can hold breath and show a glint.
// `sway_deg` is the idle sway's peak angle at a sway scale of 1 (standing, breathing),
// `flinch_deg` the view kick of a 50-damage hit from the hip (less when aimed).
// Fire modes: `fire_modes` lists the modes X cycles through, the first is the default. `Auto` fires
// while the trigger is held at `rpm`; `Burst(n)` fires n rounds per pull at `burst_rpm` and, with the
// trigger held, another burst after `burst_delay_secs` (on top of the last round's spacing, so the gap
// between bursts is clearly longer than the one inside a burst); `Semi` is one round per pull at `rpm`
// but never faster than `semi_interval_secs` (mashing the button can't beat it); `Bolt`
// (a bolt-action, listed alone) fires one round and then needs a rack: `rack_secs_scoped` is the
// click-to-rack time while aimed (with a `rack_kick_deg` sway kick), `rack_secs_unscoped` the
// automatic rack once the sights are released.
{
    AssaultRifle: (
        name: "M4 (AR)",
        fire_modes: [Auto, Burst(3), Semi],
        burst_rpm: 660.0,        // 0.09 s between burst rounds: slower than the 750 rpm auto rate
        burst_delay_secs: 0.28,
        semi_interval_secs: 0.14,
        rpm: 750.0,
        ads_rpm: 715.0,
        damage_near: 30.0,
        damage_far: 20.0,
        falloff_start: 20.0,
        falloff_end: 40.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 300.0,
        magazine: 30,
        reload_secs: 2.5,
        empty_reload_secs: 3.1,
        hip_spread_deg: 3.0,
        ads_spread_deg: 0.25,
        ads_secs: 0.25,
        ads_move_scale: 0.6,
        recoil_pitch_deg: 0.9,
        recoil_yaw_deg: 0.35,
        recoil_recovery_per_sec: 6.0,
        ads_recoil_scale: 0.55,
        move_spread_deg: 2.0,
        air_spread_deg: 5.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.2,
        move_scale: 1.0,
        model: Rifle,
        shot_sound: "embedded://frontline/sounds/shot_ar.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats. `sight_point` and
        // `sight_eye_relief` are where an Optic sits; `iron_*` are the iron sights.
        muzzle_offset: (0.0, 0.027, -0.477),
        sight_point: (0.0, 0.088, -0.07),
        sight_eye_relief: 0.16,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.066, -0.14),
        iron_eye_relief: 0.3,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.5,
        flinch_deg: 2.0,
    ),
    // The M16A4: a 3-round burst rifle with no full auto, heavier hitting and steadier than the M4.
    // The only Weapon that offers the grenade launcher (progression.ron: weapon_attachments).
    M16: (
        name: "M16A4 (AR)",
        fire_modes: [Burst(3), Semi],
        burst_rpm: 660.0,
        burst_delay_secs: 0.24,
        semi_interval_secs: 0.14,
        rpm: 700.0,
        ads_rpm: 670.0,
        damage_near: 34.0,
        damage_far: 24.0,
        falloff_start: 25.0,
        falloff_end: 50.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 1.0, limbs: 0.8),
        range: 320.0,
        magazine: 30,
        reload_secs: 2.6,
        empty_reload_secs: 3.2,
        hip_spread_deg: 2.8,
        ads_spread_deg: 0.2,
        ads_secs: 0.27,
        ads_move_scale: 0.6,
        recoil_pitch_deg: 0.8,
        recoil_yaw_deg: 0.3,
        recoil_recovery_per_sec: 6.0,
        ads_recoil_scale: 0.55,
        move_spread_deg: 2.0,
        air_spread_deg: 5.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.2,
        move_scale: 0.98,
        model: Rifle,
        shot_sound: "embedded://frontline/sounds/shot_ar.ogg",
        muzzle_offset: (0.0, 0.027, -0.477),
        sight_point: (0.0, 0.088, -0.07),
        sight_eye_relief: 0.16,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.066, -0.14),
        iron_eye_relief: 0.3,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.45,
        flinch_deg: 2.0,
    ),
    Smg: (
        name: "MP5 (SMG)",
        fire_modes: [Auto, Burst(2), Semi],
        burst_rpm: 705.0,        // 0.085 s between burst rounds (auto is 0.075 s)
        burst_delay_secs: 0.22,
        semi_interval_secs: 0.12,
        rpm: 800.0,
        ads_rpm: 800.0,
        damage_near: 25.0,
        damage_far: 15.0,
        falloff_start: 10.0,
        falloff_end: 25.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 200.0,
        magazine: 30,
        reload_secs: 2.4,
        empty_reload_secs: 2.9,
        hip_spread_deg: 2.5,
        ads_spread_deg: 0.6,
        ads_secs: 0.18,
        ads_move_scale: 0.75,
        recoil_pitch_deg: 0.7,
        recoil_yaw_deg: 0.45,
        recoil_recovery_per_sec: 7.0,
        ads_recoil_scale: 0.6,
        move_spread_deg: 1.5,
        air_spread_deg: 4.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.15,
        move_scale: 1.05,
        model: Smg,
        shot_sound: "embedded://frontline/sounds/shot_smg.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, -0.003, -0.17),
        sight_point: (0.0, 0.06, -0.02),
        sight_eye_relief: 0.12,
        scope: false,
        class: Primary,
        iron_point: (0.0, 0.04, 0.0),
        iron_eye_relief: 0.22,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.15,
        flinch_deg: 2.4,
    ),
    // Bolt-action: `Bolt`; the rack (below) paces the shots, `rpm` is only its nominal rate.
    SniperRifle: (
        name: "M40 (Sniper)",
        fire_modes: [Bolt],
        rpm: 50.0,
        ads_rpm: 50.0,
        damage_near: 100.0,
        damage_far: 80.0,
        falloff_start: 80.0,
        falloff_end: 150.0,
        zone_multipliers: (head: 1.5, upper_torso: 1.2, lower_torso: 1.0, limbs: 0.75),
        range: 400.0,
        magazine: 5,
        reload_secs: 3.5,
        empty_reload_secs: 4.0,
        hip_spread_deg: 8.0,
        ads_spread_deg: 0.0,
        ads_secs: 0.35,
        ads_move_scale: 0.4,
        recoil_pitch_deg: 3.0,
        recoil_yaw_deg: 0.5,
        recoil_recovery_per_sec: 4.0,
        ads_recoil_scale: 0.8,
        move_spread_deg: 4.0,
        air_spread_deg: 8.0,
        bloom_follow_per_sec: 6.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.3,
        move_scale: 0.9,
        model: Sniper,
        shot_sound: "embedded://frontline/sounds/shot_sniper.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.043, -0.784),
        sight_point: (0.0, 0.1145, 0.106),
        sight_eye_relief: 0.08,
        scope: true,
        class: Primary,
        iron_point: (0.0, 0.1145, 0.106),
        iron_eye_relief: 0.08,
        iron_magnification: 8.0,
        iron_sway_scale: 1.3,
        sway_deg: 1.0,
        flinch_deg: 2.5,
        rack_secs_scoped: 1.4,
        rack_secs_unscoped: 0.9,
        rack_kick_deg: 0.35,
        // Server-simulated bullet (docs/adr/0005): travel time and drop; other Weapons stay hitscan.
        projectile: Some((muzzle_speed: 600.0, gravity: 12.0)),
    ),
    // Secondary. Semi only: one round per pull at its `rpm`.
    Pistol: (
        name: "M9 (Pistol)",
        fire_modes: [Semi],
        semi_interval_secs: 0.2,
        rpm: 420.0,
        ads_rpm: 420.0,
        damage_near: 28.0,
        damage_far: 17.0,
        falloff_start: 12.0,
        falloff_end: 30.0,
        zone_multipliers: (head: 1.4, upper_torso: 1.0, lower_torso: 0.9, limbs: 0.8),
        range: 150.0,
        magazine: 15,
        reload_secs: 1.7,
        empty_reload_secs: 2.1,
        hip_spread_deg: 1.6,
        ads_spread_deg: 0.5,
        ads_secs: 0.12,
        ads_move_scale: 0.9,
        recoil_pitch_deg: 1.2,
        recoil_yaw_deg: 0.3,
        recoil_recovery_per_sec: 9.0,
        ads_recoil_scale: 0.7,
        move_spread_deg: 1.0,
        air_spread_deg: 3.0,
        bloom_follow_per_sec: 8.0,
        crouch_accuracy_scale: 0.75,
        prone_accuracy_scale: 0.5,
        sprint_out_secs: 0.1,
        move_scale: 1.1,
        model: Pistol,
        shot_sound: "embedded://frontline/sounds/shot_smg.ogg",
        // Gun-space points (metres, -Z forward); see WeaponStats.
        muzzle_offset: (0.0, 0.05, -0.079),
        sight_point: (0.0, 0.067, 0.098),
        sight_eye_relief: 0.16,
        scope: false,
        class: Secondary,
        iron_point: (0.0, 0.067, 0.098),
        iron_eye_relief: 0.16,
        iron_magnification: 1.0,
        iron_sway_scale: 0.8,
        sway_deg: 0.1,
        flinch_deg: 1.6,
    ),
}
